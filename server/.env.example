# Copy this file to server/.env and adjust values. Never commit server/.env.

NODE_ENV=development
PORT=5000

# MongoDB connection string for the application database
MONGODB_URI=mongodb://127.0.0.1:27017/leave_portal

# Used by automated tests only. Each test file creates and drops its own database
# derived from this URI, so it must point at a server you can write to.
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/leave_portal_test

# Secret used to sign login tokens. Use a long random value (32+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Origin of the React dev server (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Set to true when serving over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Maximum login attempts per IP per 15 minutes
LOGIN_RATE_LIMIT=20

# ---- Email notifications (Gmail SMTP via Nodemailer) ----
# Leave SMTP_HOST empty, or set EMAIL_ENABLED=false, to disable email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
# A 16-character Gmail App Password (NOT your normal Gmail password)
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Leave Management Portal <your-account@gmail.com>"
EMAIL_ENABLED=true
# Public URL of the web app, used for links inside emails (defaults to CLIENT_ORIGIN)
APP_URL=http://localhost:5173
